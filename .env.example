# --- обязательные ---
BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather
ADMIN_IDS=111111111,222222222

# --- пути ---
DB_PATH=data/printbot.db
JOBS_DIR=
SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
SUMATRA_PATH=tools\SumatraPDF.exe
GHOSTSCRIPT_PATH=

# --- бэкенд печати: sumatra | ghostscript | fake ---
PRINT_BACKEND=sumatra

# --- ограничения ---
MAX_FILE_MB=20
MAX_COPIES=50
LARGE_DOC_PAGES=20
DIALOG_TIMEOUT_MIN=15

# --- защита кода доступа ---
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- таймауты и обслуживание ---
CONVERT_TIMEOUT_S=120
PRINT_TIMEOUT_S=180
CLEANUP_INTERVAL_MIN=10

LOG_LEVEL=INFO
